@{
    ViewData["Title"] = "Dashboard";
}

@if (ViewBag.UserRole == "Admin")
{
    <!-- Admin Dashboard -->
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-12">
                <h1 class="h3 mb-4 text-gray-800">
                    <i class="fas fa-tachometer-alt"></i> Admin Dashboard
                </h1>
                <p class="mb-4">Welcome back, @ViewBag.UserName! Here's an overview of your asset management system.</p>
            </div>
        </div>
    </div>

        
}
else
{
    <!-- User Dashboard -->
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-12">
                <h1 class="h3 mb-4 text-gray-800">
                    <i class="fas fa-tachometer-alt"></i> My Dashboard
                </h1>
                <p class="mb-4">Welcome back, @ViewBag.UserName! Here's an overview of your assigned assets.</p>
            </div>
        </div>
    </div>
}

