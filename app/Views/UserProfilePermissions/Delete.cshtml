@model AssetTracker.Models.UserProfilePermission

<div class="container mt-4">
    <h2>Delete Permission</h2>
    <h3>Are you sure you want to delete this?</h3>
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Profile Name</dt>
                <dd class="col-sm-9">@Model.UserProfile?.profile_name</dd>

                <dt class="col-sm-3">Module Name</dt>
                <dd class="col-sm-9">@Model.module_name</dd>

                <dt class="col-sm-3">Can View</dt>
                <dd class="col-sm-9">@(Model.can_view ? "Yes" : "No")</dd>

                <dt class="col-sm-3">Can Create</dt>
                <dd class="col-sm-9">@(Model.can_create ? "Yes" : "No")</dd>

                <dt class="col-sm-3">Can Edit</dt>
                <dd class="col-sm-9">@(Model.can_edit ? "Yes" : "No")</dd>

                <dt class="col-sm-3">Can Delete</dt>
                <dd class="col-sm-9">@(Model.can_delete ? "Yes" : "No")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@(Model.status == 1 ? "Active" : "Inactive")</dd>
            </dl>
        </div>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="id" />
        <div class="mt-3">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Delete
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </form>
</div>