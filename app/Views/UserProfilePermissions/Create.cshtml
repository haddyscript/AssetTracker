@model AssetTracker.Models.UserProfilePermission

<div class="container mt-4">
    <h2>Create Permission</h2>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="user_profile_id" class="form-label"></label>
                    <select asp-for="user_profile_id" class="form-select" asp-items="@(new SelectList((IEnumerable<AssetTracker.Models.UserProfile>)ViewData["UserProfiles"], "id", "profile_name"))" required>
                        <option value="">Select Profile</option>
                    </select>
                    <span asp-validation-for="user_profile_id" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="module_name" class="form-label"></label>
                    <input asp-for="module_name" class="form-control" required />
                    <span asp-validation-for="module_name" class="text-danger"></span>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="can_view" class="form-check-input" />
                    <label asp-for="can_view" class="form-check-label"></label>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="can_create" class="form-check-input" />
                    <label asp-for="can_create" class="form-check-label"></label>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="can_edit" class="form-check-input" />
                    <label asp-for="can_edit" class="form-check-label"></label>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="can_delete" class="form-check-input" />
                    <label asp-for="can_delete" class="form-check-label"></label>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Create
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}