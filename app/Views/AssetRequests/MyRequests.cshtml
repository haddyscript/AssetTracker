@model IEnumerable<AssetTracker.Models.AssetRequest>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-list"></i> My Asset Requests</h2>
        <a href="@Url.Action("Index", "Asset")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Assets
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> You haven't submitted any asset requests yet.
            <a href="@Url.Action("Index", "Asset")">Browse available assets</a> to make a request.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Request ID</th>
                        <th>Asset</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Requested At</th>
                        <th>Approved At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.id</td>
                            <td>@request.asset?.asset_name</td>
                            <td>
                                <span class="badge @(request.request_type == "Borrow" ? "bg-primary" : "bg-info")">
                                    @request.request_type
                                </span>
                            </td>
                            <td>
                                <span class="badge @(
                                    request.status == "Pending" ? "bg-warning" :
                                    request.status == "Approved" ? "bg-success" :
                                    request.status == "Rejected" ? "bg-danger" : "bg-secondary")">
                                    @request.status
                                </span>
                            </td>
                            <td>@request.requested_at.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(request.approved_at?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = request.id })"
                                   class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>