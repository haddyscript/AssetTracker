@model IEnumerable<AssetTracker.Models.User>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Users</h2>
        <a asp-controller="Users" asp-action="Register" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add User
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No users found. <a asp-controller="Users" asp-action="Register">Add your first user</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>User Profile</th>
                        <th>Created At</th>
                        <th style="width: 250px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.username</td>
                            <td>@user.full_name</td>
                            <td>@user.email</td>
                            <td>@(user.UserProfile?.profile_name ?? "N/A")</td>
                            <td>@user.created_at.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <a asp-controller="Users" asp-action="Details" asp-route-id="@user.id" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> View Details
                                </a>
                                <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.id" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-controller="Users" asp-action="Delete" asp-route-id="@user.id" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>