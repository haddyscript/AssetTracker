@model IEnumerable<AssetTracker.Models.User>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Users</h2>
        <a asp-controller="Users" asp-action="Register" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add User
        </a>
    </div>

    <table id="usersTable" class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>User Profile</th>
                <th>Created At</th>
                <th style="width: 250px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.username</td>
                    <td>@user.full_name</td>
                    <td>@user.email</td>
                    <td>@(user.UserProfile?.profile_name ?? "N/A")</td>
                    <td>@user.created_at.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>
                        <a asp-controller="Users" asp-action="Details" asp-route-id="@user.id"
                           class="btn btn-sm btn-info">
                            <i class="fas fa-eye"></i> View
                        </a>

                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.id"
                           class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Edit
                        </a>

                        <a asp-controller="Users" asp-action="Delete" asp-route-id="@user.id"
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Are you sure you want to delete this user?');">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script>$(document).ready(function () {
            $('#usersTable').DataTable({
                pageLength: 10,
                order: [
                    [4, 'desc'] // Created At
                ],
                columnDefs: [
                    { orderable: false, targets: 5 } // Actions column
                ]
            });
        });</script>
}
