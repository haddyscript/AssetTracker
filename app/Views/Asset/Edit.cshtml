@model AssetTracker.Models.Asset

<div class="container mt-4">
    <h2>Edit Asset</h2>

    @using (Html.BeginForm("EditAction", "Asset", FormMethod.Post, new { @class = "mt-3" }))
    {
        @Html.HiddenFor(m => m.id) <!-- hidden id for tracking -->

        <div class="mb-3">
            @Html.LabelFor(m => m.assetName, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.assetName, new { @class = "form-control", placeholder = "Enter asset name" })
            @Html.ValidationMessageFor(m => m.assetName, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Quantity, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", type = "number", placeholder = "Enter quantity", min = "1" })
            @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Category, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Category, new { @class = "form-control", placeholder = "Enter category" })
            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.AssignedTo, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.AssignedTo, new { @class = "form-control", placeholder = "Assigned to" })
            @Html.ValidationMessageFor(m => m.AssignedTo, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary">Update Asset</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Cancel</a>
    }
</div>
