@model AssetTracker.Models.Asset

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-plus-circle"></i> Add New Asset</h2>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm("Create", "Asset", FormMethod.Post, new { @class = "mt-3" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.asset_tag, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.asset_tag, new { @class = "form-control", placeholder = "Enter asset tag" })
                            @Html.ValidationMessageFor(m => m.asset_tag, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.asset_name, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.asset_name, new { @class = "form-control", placeholder = "Enter asset name" })
                            @Html.ValidationMessageFor(m => m.asset_name, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.category, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.category, new { @class = "form-control", placeholder = "Enter category" })
                            @Html.ValidationMessageFor(m => m.category, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.brand, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.brand, new { @class = "form-control", placeholder = "Enter brand" })
                            @Html.ValidationMessageFor(m => m.brand, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.model, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.model, new { @class = "form-control", placeholder = "Enter model" })
                            @Html.ValidationMessageFor(m => m.model, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.serial_number, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.serial_number, new { @class = "form-control", placeholder = "Enter serial number" })
                            @Html.ValidationMessageFor(m => m.serial_number, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.purchase_date, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.purchase_date, new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.purchase_date, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.purchase_price, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.purchase_price, new { @class = "form-control", type = "number", step = "0.01", placeholder = "0.00" })
                            @Html.ValidationMessageFor(m => m.purchase_price, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.status, new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.status, new SelectList(new[] { "Available", "Assigned", "Maintenance", "Retired" }, Model.status ?? "Available"), new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.status, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.condition, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.condition, new { @class = "form-control", placeholder = "Enter condition" })
                            @Html.ValidationMessageFor(m => m.condition, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.description, new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.description, new { @class = "form-control", rows = 3, placeholder = "Enter description" })
                    @Html.ValidationMessageFor(m => m.description, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.assigned_to_user_id, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.assigned_to_user_id, new SelectList(ViewBag.Users, "id", "username"), "Not Assigned", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.assigned_to_user_id, "", new { @class = "text-danger" })
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save"></i> Save Asset
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            }
        </div>
    </div>
</div>
