@model AssetTracker.Models.Asset

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-trash-alt text-danger"></i> Delete Asset</h2>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Confirm Deletion</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Warning!</strong> This action cannot be undone. Are you sure you want to delete this asset?
            </div>

            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Asset Tag:</dt>
                        <dd class="col-sm-8">@Model.asset_tag</dd>

                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.asset_name</dd>

                        <dt class="col-sm-4">Category:</dt>
                        <dd class="col-sm-8">@Model.category</dd>

                        <dt class="col-sm-4">Brand:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.brand) ? "N/A" : Model.brand)</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.status == "Available" ? "bg-success" : Model.status == "Assigned" ? "bg-primary" : "bg-warning")">
                                @Model.status
                            </span>
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Assigned To:</dt>
                        <dd class="col-sm-8">
                            @if (Model.assigned_user != null)
                            {
                                @Model.assigned_user.username
                            }
                            else
                            {
                                <span class="text-muted">Not assigned</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Purchase Price:</dt>
                        <dd class="col-sm-8">@(Model.purchase_price.HasValue ? Model.purchase_price.Value.ToString("C") : "N/A")</dd>

                        <dt class="col-sm-4">Created:</dt>
                        <dd class="col-sm-8">@Model.created_at.ToString("yyyy-MM-dd HH:mm:ss")</dd>

                        <dt class="col-sm-4">Last Updated:</dt>
                        <dd class="col-sm-8">@Model.updated_at.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                    </dl>
                </div>
            </div>

            @using (Html.BeginForm("DeleteConfirmed", "Asset", FormMethod.Post, new { @class = "d-inline" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.id)

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Yes, Delete Asset
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            }
        </div>
    </div>
</div>