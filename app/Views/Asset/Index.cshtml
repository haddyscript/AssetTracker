@model IEnumerable<AssetTracker.Models.Asset>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Asset List</h2>
        <div>
            @if (User.IsInRole("User"))
            {
                <a href="@Url.Action("MyRequests", "AssetRequests")" class="btn btn-outline-primary me-2">
                    <i class="fas fa-list"></i> My Requests
                </a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a href="@Url.Action("Index", "AssetRequests")" class="btn btn-outline-secondary me-2">
                    <i class="fas fa-clipboard-list"></i> Manage Requests
                </a>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add Asset
                </a>
            }
        </div>
    </div>

    <table id="assetTable" class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Asset Tag</th>
                <th>Name</th>
                <th>Category</th>
                <th>Brand</th>
                <th>Status</th>
                <th>Assigned To</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asset in Model)
            {
                <tr>
                    <td>@asset.asset_tag</td>
                    <td>@asset.asset_name</td>
                    <td>@asset.category</td>
                    <td>@asset.brand</td>
                    <td>
                        <span class="badge @(asset.status == "Available" ? "bg-success" :
                                             asset.status == "Assigned" ? "bg-primary" : "bg-warning")">
                            @asset.status
                        </span>
                    </td>
                    <td>
                        @if (asset.assigned_user != null)
                        {
                            @asset.assigned_user.username
                        }
                        else
                        {
                            <span class="text-muted">Not assigned</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a href="@Url.Action("Details", new { id = asset.id })"
                               class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Details
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a href="@Url.Action("Edit", new { id = asset.id })"
                                   class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a href="@Url.Action("Delete", new { id = asset.id })"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this asset?');">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            }
                            else if (User.IsInRole("User"))
                            {
                                @if (asset.status == "Available")
                                {
                                    <a href="@Url.Action("CreateBorrowRequest", "AssetRequests", new { id = asset.id })"
                                       class="btn btn-sm btn-primary">
                                        <i class="fas fa-hand-holding"></i> Borrow
                                    </a>
                                }
                                else if (asset.status == "Assigned"
                                         && asset.assigned_to_user_id ==
                                         int.Parse(User.FindFirst("UserId")?.Value ?? "0"))
                                {
                                    <a href="@Url.Action("CreateReturnRequest", "AssetRequests", new { id = asset.id })"
                                       class="btn btn-sm btn-success">
                                        <i class="fas fa-undo"></i> Return
                                    </a>
                                }
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script>$(document).ready(function () {
            $('#assetTable').DataTable({
                pageLength: 10,
                order: [
                    [0, 'asc'], // Asset Name
                    [1, 'asc']  // Asset Tag
                ],
                columnDefs: [
                    { orderable: false, targets: 6 } // Actions column
                ]
            });
        });</script>
}
