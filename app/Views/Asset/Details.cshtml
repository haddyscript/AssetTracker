@model AssetTracker.Models.Asset

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-cube"></i> Asset Details</h2>
        <div>
            <a href="@Url.Action("Edit", new { id = Model.id })" class="btn btn-warning me-2">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">@Model.asset_name</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Asset Tag:</dt>
                        <dd class="col-sm-8">@Model.asset_tag</dd>

                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.asset_name</dd>

                        <dt class="col-sm-4">Category:</dt>
                        <dd class="col-sm-8">@Model.category</dd>

                        <dt class="col-sm-4">Brand:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.brand) ? "N/A" : Model.brand)</dd>

                        <dt class="col-sm-4">Model:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.model) ? "N/A" : Model.model)</dd>

                        <dt class="col-sm-4">Serial Number:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.serial_number) ? "N/A" : Model.serial_number)</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.status == "Available" ? "bg-success" : Model.status == "Assigned" ? "bg-primary" : "bg-warning")">
                                @Model.status
                            </span>
                        </dd>

                        <dt class="col-sm-4">Condition:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.condition) ? "N/A" : Model.condition)</dd>

                        <dt class="col-sm-4">Purchase Date:</dt>
                        <dd class="col-sm-8">@(Model.purchase_date?.ToString("yyyy-MM-dd") ?? "N/A")</dd>

                        <dt class="col-sm-4">Purchase Price:</dt>
                        <dd class="col-sm-8">@(Model.purchase_price.HasValue ? Model.purchase_price.Value.ToString("C") : "N/A")</dd>

                        <dt class="col-sm-4">Assigned To:</dt>
                        <dd class="col-sm-8">
                            @if (Model.assigned_user != null)
                            {
                                @Model.assigned_user.username
                            }
                            else
                            {
                                <span class="text-muted">Not assigned</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Assigned Date:</dt>
                        <dd class="col-sm-8">@(Model.assigned_date?.ToString("yyyy-MM-dd") ?? "N/A")</dd>
                    </dl>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.description))
            {
                <div class="row">
                    <div class="col-12">
                        <dt>Description:</dt>
                        <dd>@Model.description</dd>
                    </div>
                </div>
            }

            <hr />
            <div class="row">
                <div class="col-md-6">
                    <small class="text-muted">
                        <strong>Created:</strong> @Model.created_at.ToString("yyyy-MM-dd HH:mm:ss")
                    </small>
                </div>
                <div class="col-md-6 text-end">
                    <small class="text-muted">
                        <strong>Last Updated:</strong> @Model.updated_at.ToString("yyyy-MM-dd HH:mm:ss")
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>