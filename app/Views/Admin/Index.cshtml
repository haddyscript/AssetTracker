@model IEnumerable<AssetTracker.Models.Admin>

@{
    ViewData["Title"] = "Admins";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Admins</h2>
        <a asp-action="Register" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Admin
        </a>
    </div>

    <table id="adminTable" class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>User Profile</th>
                <th>Status</th>
                <th>Created At</th>
                <th style="width: 200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var admin in Model)
            {
                <tr>
                    <td>@admin.id</td>
                    <td>@admin.username</td>
                    <td>@admin.full_name</td>
                    <td>@admin.email</td>
                    <td>@admin.UserProfile?.profile_name</td>
                    <td>
                        <span class="badge @(admin.is_active ? "bg-success" : "bg-secondary")">
                            @(admin.is_active ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>@admin.created_at.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@admin.id" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@admin.id" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#adminTable').DataTable({
                pageLength: 10,
                order: [
                    [0, 'asc'], // Username
                    [1, 'asc']  // ID
                ],
                columnDefs: [
                    { orderable: false, targets: 7 }
                ]
            });
        });
    </script>
}
