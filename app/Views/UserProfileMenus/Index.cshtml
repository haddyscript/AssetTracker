@model IEnumerable<AssetTracker.Models.UserProfileMenu>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">User Profile Menus</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Assign Menu
        </a>
    </div>

    <table id="userProfileMenuTable" class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Profile Name</th>
                <th>Menu Name</th>
                <th>Can View</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var upm in Model)
            {
                <tr>
                    <td>@upm.UserProfile?.profile_name</td>
                    <td>@upm.Menu?.menu_name</td>
                    <td>
                        <span class="badge @(upm.can_view ? "bg-success" : "bg-secondary")">
                            @(upm.can_view ? "Yes" : "No")
                        </span>
                    </td>
                    <td>
                        <span class="badge @(upm.status == 1 ? "bg-primary" : "bg-danger")">
                            @(upm.status == 1 ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = upm.id })" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a href="@Url.Action("Delete", new { id = upm.id })" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script>$(document).ready(function () {
            $('#userProfileMenuTable').DataTable({
                pageLength: 10,
                order: [
                    [1, 'asc'], // Profile Name
                    [0, 'asc']  // Menu Name
                ],
                columnDefs: [
                    { orderable: false, targets: 4 } // Actions column
                ]
            });
        });</script>
}
