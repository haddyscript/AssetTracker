@model IEnumerable<AssetTracker.Models.UserProfileMenu>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">User Profile Menus</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Assign Menu
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No menu assignments found. <a href="@Url.Action("Create")">Assign your first menu</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Profile Name</th>
                        <th>Menu Name</th>
                        <th>Can View</th>
                        <th>Status</th>
                        <th style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var upm in Model)
                    {
                        <tr>
                            <td>@upm.UserProfile?.profile_name</td>
                            <td>@upm.Menu?.menu_name</td>
                            <td>@(upm.can_view ? "Yes" : "No")</td>
                            <td>@(upm.status == 1 ? "Active" : "Inactive")</td>
                            <td>
                                <a href="@Url.Action("Details", new { id = upm.id })" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Details
                                </a>
                                <a href="@Url.Action("Edit", new { id = upm.id })" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a href="@Url.Action("Delete", new { id = upm.id })" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>