@model AssetTracker.Models.UserProfileMenu

<div class="container mt-4">
    <h2>Edit Menu Assignment</h2>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="id" />
        <input type="hidden" asp-for="user_profile_id" />
        <input type="hidden" asp-for="menu_id" />
        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="user_profile_id" class="form-label"></label>
                    <select asp-for="user_profile_id" class="form-select" disabled readonly>
                        @foreach (var profile in (IEnumerable<AssetTracker.Models.UserProfile>)ViewData["UserProfiles"])
                        {
                            <option value="@profile.id" selected="@(Model.user_profile_id == profile.id ? "selected" : null)">@profile.profile_name</option>
                        }
                    </select>
                    <span asp-validation-for="user_profile_id" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="menu_id" class="form-label"></label>
                    <select asp-for="menu_id" class="form-select" disabled readonly>
                        @foreach (var menu in (IEnumerable<AssetTracker.Models.Menu>)ViewData["Menus"])
                        {
                            <option value="@menu.id" selected="@(Model.menu_id == menu.id ? "selected" : null)">@menu.menu_name</option>
                        }
                    </select>
                    <span asp-validation-for="menu_id" class="text-danger"></span>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="can_view" class="form-check-input" />
                    <label asp-for="can_view" class="form-check-label"></label>
                </div>
                <div class="mb-3">
                    <label asp-for="status" class="form-label"></label>
                    <select asp-for="status" class="form-select">
                        <option value="1" selected="@(Model.status == 1 ? "selected" : null)">Active</option>
                        <option value="0" selected="@(Model.status == 0 ? "selected" : null)">Inactive</option>
                    </select>
                    <span asp-validation-for="status" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Save
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}