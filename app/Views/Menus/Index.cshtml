@model IEnumerable<AssetTracker.Models.Menu>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Menus</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Menu
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No menus found. <a href="@Url.Action("Create")">Add your first menu</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Menu Name</th>
                        <th>Route</th>
                        <th>Icon</th>
                        <th>Parent Menu</th>
                        <th>Sort Order</th>
                        <th>Active</th>
                        <th style="width: 200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var menu in Model)
                    {
                        <tr>
                            <td>@menu.menu_name</td>
                            <td>@menu.route</td>
                            <td>@(string.IsNullOrEmpty(menu.icon) ? "-" : $"<i class='{menu.icon}'></i>")</td>
                            <td>@(menu.ParentMenu?.menu_name ?? "-")</td>
                            <td>@menu.sort_order</td>
                            <td>@(menu.is_active ? "Yes" : "No")</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = menu.id })" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a href="@Url.Action("Delete", new { id = menu.id })" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>