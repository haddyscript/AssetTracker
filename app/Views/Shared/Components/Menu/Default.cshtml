@model IEnumerable<AssetTracker.Models.Menu>

@if (Model.Any())
{
@foreach (var menu in Model.Where(m => m.parent_id == null))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="javascript:void(0)" id="@($"navbarDropdown{menu.id}")" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                @if (!string.IsNullOrEmpty(menu.icon))
                {
                    <i class="@menu.icon me-1"></i>
                }
                @menu.menu_name
            </a>
            <ul class="dropdown-menu" id="@($"dropdownMenu{menu.id}")">
                @foreach (var child in menu.ChildMenus.OrderBy(c => c.sort_order))
                {
                    if (child.menu_name != "Privacy")
                    {
                        <li><a class="dropdown-item" href="@child.route">@if (!string.IsNullOrEmpty(child.icon)) { <i class="@child.icon me-1"></i> }@child.menu_name</a></li>
                    }
                }
            </ul>
        </li>
    }
}